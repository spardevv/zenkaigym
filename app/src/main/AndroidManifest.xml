<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Aviso de fim do descanso no modo treino. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Só para o botão "Verificar atualização" (consulta a última versão no GitHub, ao toque). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Lembretes opcionais de refeição e treino (notificações locais). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Avisar o fim do descanso na hora certa com a tela apagada (só durante o descanso). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Serviço curto em primeiro plano só durante o descanso (impede o sistema de congelar o app). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <application
        android:name=".ZenApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Zenkaigym"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Zenkaigym">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".notify.ReminderReceiver"
            android:exported="false" />
        <service
            android:name=".notify.RestService"
            android:exported="false"
            android:foregroundServiceType="shortService" />

        <!-- Botões "+30 s" e "Pular" da notificação de descanso. -->
        <receiver
            android:name=".notify.RestActionReceiver"
            android:exported="false" />

        <!-- Widget do Dojo na tela inicial. -->
        <receiver
            android:name=".widget.DojoWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/dojo_widget_info" />
        </receiver>

        <!-- Compartilhar o cartão da semana (imagem temporária no cache). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name=".notify.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>